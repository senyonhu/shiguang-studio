    "JsonValue": {},
    "Layout": {
      "additionalProperties": false,
      "description": "Coordinates/sizes are fractions of the canvas; anchors of the component.",
      "properties": {
        "x": {
          "default": 0.5,
          "maximum": 3.0,
          "minimum": -2.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 1.0,
          "maximum": 3.0,
          "minimum": -2.0,
          "title": "Y",
          "type": "number"
        },
        "anchor_x": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Anchor X",
          "type": "number"
        },
        "anchor_y": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Anchor Y",
          "type": "number"
        },
        "width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 4.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        },
        "height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 4.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "fit": {
          "default": "contain",
          "enum": [
            "contain",
            "cover"
          ],
          "title": "Fit",
          "type": "string"
        }
      },
      "title": "Layout",
      "type": "object"
    },
    "LayoutProfile": {
      "additionalProperties": false,
      "properties": {
        "safe_margin": {
          "default": 0.04,
          "maximum": 0.25,
          "minimum": 0.0,
          "title": "Safe Margin",
          "type": "number"
        },
        "dialogue_height": {
          "default": 0.24,
          "exclusiveMinimum": 0.0,
          "maximum": 0.6,
          "title": "Dialogue Height",
          "type": "number"
        },
        "font_size": {
          "default": 32,
          "maximum": 128,
          "minimum": 12,
          "title": "Font Size",
          "type": "integer"
