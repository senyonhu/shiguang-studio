          "type": "string"
        },
        "type": {
          "enum": [
            "int",
            "float",
            "bool",
            "str"
          ],
          "title": "Type",
          "type": "string"
        },
        "default": {
          "$ref": "#/$defs/JsonValue"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "allowed_values": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/JsonValue"
