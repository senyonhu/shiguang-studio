      "type": "object"
    },
    "ResultBranch": {
      "additionalProperties": false,
      "properties": {
        "branch_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Branch Id",
          "type": "string"
        },
        "outcome": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Outcome",
          "type": "string"
