        "zorder": {
          "default": 0,
          "maximum": 1000,
          "minimum": -1000,
          "title": "Zorder",
          "type": "integer"
        },
        "font_size": {
          "default": 32,
          "maximum": 128,
          "minimum": 12,
          "title": "Font Size",
          "type": "integer"
        },
        "color": {
          "default": "#ffffff",
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
          "title": "Color",
          "type": "string"
        },
        "provenance": {
