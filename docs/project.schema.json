      "type": "object"
    },
    "Predicate": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "enum": [
            "eq",
            "ne",
            "lt",
            "lte",
            "gt",
            "gte",
            "all",
            "any",
            "not"
          ],
          "title": "Op",
          "type": "string"
        },
        "left": {
          "anyOf": [
            {
              "$ref": "#/$defs/ValueBinding"
            },
