          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "provenance": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Provenance",
          "type": "object"
        }
      },
      "required": [
        "asset_id",
        "kind",
        "path",
        "sha256"
      ],
      "title": "Asset",
      "type": "object"
    },
    "Canvas": {
      "additionalProperties": false,
      "properties": {
        "width": {
          "default": 1280,
          "maximum": 7680,
          "minimum": 320,
          "title": "Width",
