        "act_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Act Id",
          "type": "string"
        },
        "name": {
          "default": "第一幕",
          "title": "Name",
          "type": "string"
        },
        "order": {
          "default": 0,
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "frame_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "title": "Frame Ids",
          "type": "array"
        },
        "provenance": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Provenance",
          "type": "object"
        }
      },
      "required": [
        "act_id"
      ],
      "title": "Act",
      "type": "object"
    },
    "Asset": {
      "additionalProperties": false,
